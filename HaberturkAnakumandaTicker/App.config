<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <connectionStrings>
        <add name="HtTicker"
             connectionString="Server=127.0.0.1;Port=3306;Database=ht_ticker;Uid=root;Pwd=;CharSet=utf8mb4;SslMode=None;AllowPublicKeyRetrieval=True;"
             providerName="MySql.Data.MySqlClient" />
    </connectionStrings>
</configuration>
